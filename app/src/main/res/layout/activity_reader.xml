<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Panel lateral (Fold abierto): índice, marcadores o notas fijos en una mitad -->
        <LinearLayout
            android:id="@+id/sidePanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/sideTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:textSize="20sp" />

            <FrameLayout
                android:id="@+id/sideTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp" />

            <TextView
                android:id="@+id/sideStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingBottom="6dp"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sideList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />

            <!-- Cuaderno del libro (texto y S Pen) -->
            <FrameLayout
                android:id="@+id/sideNotebook"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:id="@+id/sideDivider"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Libro: páginas (BookView) o desplazamiento continuo (se añade encima por código) -->
        <FrameLayout
            android:id="@+id/bookFrame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.emmanuel.epubfold.BookView
                android:id="@+id/book"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <!-- Barra superior -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/back"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/bookTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/chapterTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnPanel"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Panel lateral"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_panel"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnBookmark"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Marcador"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bookmark_border" />

        <ImageButton
            android:id="@+id/btnNight"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/theme"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_moon" />
    </LinearLayout>

    <!-- Panel flotante inferior -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/bottomCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/toolToc"
                    style="@style/ReaderTool">
                    <ImageView
                        android:id="@+id/iconToc"
                        style="@style/ReaderToolIcon"
                        android:src="@drawable/ic_toc" />
                    <TextView
                        android:id="@+id/labelToc"
                        style="@style/ReaderToolLabel"
                        android:text="Contenido" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolSearch"
                    style="@style/ReaderTool">
                    <ImageView
                        android:id="@+id/iconSearch"
                        style="@style/ReaderToolIcon"
                        android:src="@drawable/ic_search" />
                    <TextView
                        android:id="@+id/labelSearch"
                        style="@style/ReaderToolLabel"
                        android:text="Buscar" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolListen"
                    style="@style/ReaderTool">
                    <ImageView
                        android:id="@+id/iconListen"
                        style="@style/ReaderToolIcon"
                        android:src="@drawable/ic_headphones" />
                    <TextView
                        android:id="@+id/labelListen"
                        style="@style/ReaderToolLabel"
                        android:text="Escuchar" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolThemes"
                    style="@style/ReaderTool">
                    <ImageView
                        android:id="@+id/iconThemes"
                        style="@style/ReaderToolIcon"
                        android:src="@drawable/ic_text" />
                    <TextView
                        android:id="@+id/labelThemes"
                        style="@style/ReaderToolLabel"
                        android:text="Ajustes" />
                </LinearLayout>
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/pageInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/timeInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <!-- Mini reproductor de lectura en voz alta -->
    <LinearLayout
        android:id="@+id/player"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/playerToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Reproducir o pausar"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pause" />

        <TextView
            android:id="@+id/playerRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="1×"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/playerTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:contentDescription="Temporizador"
            android:drawablePadding="4dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/playerMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Más opciones de voz"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more" />

        <ImageButton
            android:id="@+id/playerClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Detener"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </LinearLayout>
</FrameLayout>
